---
const {
    eyebrow,
    title,
    subtitle,
    caption,
    ctaText,
    ctaHref,
    image,
    imageAlt = "",
    imageFit = "cover",
    imagePadding = "p-10",
    bgClass = "",
    gradient = "from-zinc-700 via-zinc-800 to-black",
    initial,
    eyebrowTone = "light",
} = Astro.props;

const isExternal = ctaHref && /^https?:\/\//.test(ctaHref);
const isImpression = !title && caption;
const isContain = image && imageFit === "contain";

const eyebrowClass =
    eyebrowTone === "dark"
        ? "text-ink/80"
        : "text-white/95 drop-shadow-sm";
---

<a
    href={ctaHref}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener" : undefined}
    class="group relative block w-full h-full rounded-[1.5rem] overflow-hidden shadow-[0_24px_60px_-30px_rgba(0,0,0,0.3)] transition-transform duration-500 ease-out hover:scale-[1.01]"
>
    {
        image && imageFit === "cover" && (
            <img
                src={image}
                alt={imageAlt}
                class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                loading="lazy"
            />
        )
    }
    {
        isContain && (
            <div class={`absolute inset-0 ${bgClass || "bg-stone-100"}`}>
                <img
                    src={image}
                    alt={imageAlt}
                    class={`absolute inset-0 w-full h-full object-contain ${imagePadding} transition-transform duration-700 ease-out group-hover:scale-[1.04]`}
                    loading="lazy"
                />
            </div>
        )
    }
    {
        !image && (
            <div class={`absolute inset-0 bg-gradient-to-br ${gradient}`}>
                {initial && (
                    <div class="absolute inset-0 flex items-center justify-center">
                        <span
                            class="text-[8rem] md:text-[9rem] font-bold tracking-tightish text-white/85 select-none"
                            style="text-shadow: 0 4px 60px rgba(0,0,0,0.18);"
                        >
                            {initial}
                        </span>
                    </div>
                )}
            </div>
        )
    }

    {
        title && (
            <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/70 via-black/30 to-transparent pointer-events-none" />
        )
    }

    {
        eyebrow && (
            <div class={`absolute top-5 left-5 text-xs font-semibold tracking-tight ${eyebrowClass}`}>
                {eyebrow}
            </div>
        )
    }

    {
        title && (
            <div class="absolute inset-x-0 bottom-0 px-5 pb-5 pt-12">
                <h3 class="text-xl md:text-2xl font-bold tracking-tightish leading-[1.1] text-white">
                    {title}
                </h3>
                {(ctaText || subtitle) && (
                    <div class="mt-3 flex items-center gap-2.5 flex-wrap">
                        {ctaText && (
                            <span class="rounded-full bg-white px-4 py-1.5 text-xs font-medium text-ink transition-opacity group-hover:opacity-90">
                                {ctaText}
                            </span>
                        )}
                        {subtitle && (
                            <span class="text-xs text-white/85">{subtitle}</span>
                        )}
                    </div>
                )}
            </div>
        )
    }

    {
        isImpression && (
            <div class="absolute bottom-5 left-5">
                <span class="rounded-full bg-white/90 backdrop-blur px-3.5 py-1.5 text-xs font-medium text-ink">
                    {caption}
                </span>
            </div>
        )
    }
</a>
