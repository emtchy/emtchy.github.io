---
const {
    title,
    image,
    imageAlt = "",
    imageFit = "cover",
    imagePadding = "p-8",
    bgClass = "bg-stone-100",
    gradient = "from-zinc-700 via-zinc-800 to-black",
    initial,
    tileId,
} = Astro.props;

const isContain = imageFit === "contain";

const titleEn = typeof title === "string" ? title : title?.en;
const titleDe = typeof title === "string" ? title : title?.de;
---

<button
    type="button"
    data-tile={tileId}
    aria-label={`Show details for ${titleEn ?? ""}`}
    class="project-tile group relative block w-full h-full rounded-[1.5rem] overflow-hidden shadow-[0_24px_60px_-30px_rgba(0,0,0,0.3)] transition-transform duration-500 ease-out hover:scale-[1.01] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/70"
>
    {image && !isContain && (
        <img
            src={image}
            alt={imageAlt}
            class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]"
            loading="lazy"
        />
    )}
    {image && isContain && (
        <div class={`absolute inset-0 ${bgClass}`}>
            <img
                src={image}
                alt={imageAlt}
                class={`absolute inset-0 w-full h-full object-contain ${imagePadding} transition-transform duration-700 ease-out group-hover:scale-[1.04]`}
                loading="lazy"
            />
        </div>
    )}
    {!image && (
        <div class={`absolute inset-0 bg-gradient-to-br ${gradient}`}>
            {initial && (
                <div class="absolute inset-0 flex items-center justify-center">
                    <span
                        class="text-[7rem] md:text-[8rem] font-bold tracking-tightish text-white/85 select-none"
                        style="text-shadow: 0 4px 60px rgba(0,0,0,0.18);"
                    >
                        {initial}
                    </span>
                </div>
            )}
        </div>
    )}

    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/70 via-black/30 to-transparent pointer-events-none" />
    <div class="absolute inset-x-0 bottom-0 px-5 pb-5 pt-12 text-left">
        <h3 class="text-xl md:text-2xl font-bold tracking-tightish leading-[1.1] text-white">
            <span data-lang="en">{titleEn}</span>
            <span data-lang="de">{titleDe}</span>
        </h3>
    </div>
</button>
