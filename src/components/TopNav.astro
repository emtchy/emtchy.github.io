---
const { activeNav } = Astro.props;

const links = [
    { id: "home", labelEn: "Home", labelDe: "Start", href: "/" },
    { id: "work", labelEn: "Projects", labelDe: "Projekte", href: "/#work" },
    { id: "cv", labelEn: "CV", labelDe: "Lebenslauf", href: "/cv" },
    {
        id: "contact",
        labelEn: "Contact",
        labelDe: "Kontakt",
        href: "mailto:emily@gombocz.com",
    },
];
---

<header
    id="topnav"
    class="fixed inset-x-0 top-0 z-50 transition-colors duration-200"
>
    <div
        class="mx-auto flex h-[var(--nav-h)] max-w-[1100px] items-center justify-between px-6 text-[15px]"
    >
        <a
            href="/"
            class="font-semibold tracking-tightish text-ink hover:opacity-70 transition-opacity"
        >
            Emily Gombocz
        </a>

        <nav class="flex items-center gap-7">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        data-nav-id={link.id}
                        class:list={[
                            "transition-opacity hover:opacity-70",
                            activeNav === link.id
                                ? "text-ink font-medium"
                                : "text-ink-muted",
                        ]}
                    >
                        <span data-lang="en">{link.labelEn}</span>
                        <span data-lang="de">{link.labelDe}</span>
                    </a>
                ))
            }

            <div
                role="group"
                aria-label="Language"
                class="ml-2 flex items-center gap-1 rounded-full border border-ink/15 px-1 py-0.5 text-xs"
            >
                <button
                    type="button"
                    data-lang-set="en"
                    class="lang-btn rounded-full px-2 py-0.5 text-ink-muted transition-colors hover:text-ink"
                >
                    EN
                </button>
                <button
                    type="button"
                    data-lang-set="de"
                    class="lang-btn rounded-full px-2 py-0.5 text-ink-muted transition-colors hover:text-ink"
                >
                    DE
                </button>
            </div>
        </nav>
    </div>
</header>

<script>
    const nav = document.getElementById("topnav");
    if (nav) {
        const update = () => {
            if (window.scrollY > 8) {
                nav.classList.add(
                    "bg-surface/70",
                    "backdrop-blur-xl",
                    "border-b",
                    "border-black/5",
                );
            } else {
                nav.classList.remove(
                    "bg-surface/70",
                    "backdrop-blur-xl",
                    "border-b",
                    "border-black/5",
                );
            }
        };
        update();
        window.addEventListener("scroll", update, { passive: true });
    }
</script>
