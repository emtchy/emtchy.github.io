---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectTile from "../components/ProjectTile.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import { personalRows, university } from "../data/projects";

const personal = personalRows;
---

<BaseLayout title="Projects" activeNav="work">
    <section class="pt-4 pb-12">
        <div data-reveal class="mb-3 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
            <span data-lang="en">Work</span>
            <span data-lang="de">Arbeit</span>
        </div>
        <h1 data-reveal data-reveal-delay="1" class="text-5xl md:text-6xl font-bold tracking-tightish leading-[1.02] text-ink">
            <span data-lang="en">Things I've built.</span>
            <span data-lang="de">Dinge, die ich gebaut habe.</span>
        </h1>
        <p data-reveal data-reveal-delay="2" class="mt-4 text-sm text-ink-muted">
            <span data-lang="en">Hover any tile for the details.</span>
            <span data-lang="de">Bewege die Maus über eine Kachel, um Details zu sehen.</span>
        </p>
    </section>

    {/* PERSONAL PROJECTS — two rows, each its own preview-group so the preview pops up within the same row as the hovered tile */}
    <section class="pb-16">
        <h2 data-reveal class="mb-6 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
            <span data-lang="en">Personal projects</span>
            <span data-lang="de">Persönliche Projekte</span>
        </h2>

        {personal.map((row, idx) => (
            <div
                data-reveal
                data-reveal-delay="1"
                class:list={[
                    "project-group relative",
                    idx > 0 && "mt-5 md:mt-6",
                ]}
                data-project-group
            >
                <div class="tiles-grid grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-6">
                    {row.map((p) => (
                        <div
                            class:list={[
                                p.size === "big" ? "md:col-span-8" : "md:col-span-4",
                                idx === 1
                                    ? p.size === "big"
                                        ? "h-[180px] md:h-[300px]"
                                        : "h-[150px] md:h-[300px]"
                                    : p.size === "big"
                                        ? "h-[260px] md:h-[440px]"
                                        : "h-[220px] md:h-[440px]",
                            ]}
                        >
                            <ProjectTile tileId={p.id} {...p.tile} />
                        </div>
                    ))}
                </div>
                {row.map((p) => (
                    <ProjectPreview previewId={p.id} {...p.preview} />
                ))}
            </div>
        ))}
    </section>

    {/* UNIVERSITY PROJECTS*/}
    <section class="pb-24">
        <h2 data-reveal class="mb-6 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
            <span data-lang="en">University projects</span>
            <span data-lang="de">Studienprojekte</span>
        </h2>
        <div data-reveal data-reveal-delay="1" class="project-group relative" data-project-group>
            <div class="tiles-grid grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
                {university.map((p) => (
                    <div class="h-[240px] md:h-[360px]">
                        <ProjectTile tileId={p.id} {...p.tile} />
                    </div>
                ))}
            </div>
            {university.map((p) => (
                <ProjectPreview previewId={p.id} {...p.preview} />
            ))}
        </div>
    </section>
</BaseLayout>
