---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";

const skills = [
    {
        group: { en: "Programming", de: "Programmierung" },
        items: [
            "C",
            "C++",
            "Java",
            "Python",
            "JavaScript",
            "TypeScript",
            "SystemVerilog",
            "SQL",
            "RISC-V",
            "Scala",
            "Prolog"
        ],
    },
    {
        group: { en: "Frameworks & Tools", de: "Frameworks & Tools" },
        items: [
            "Astro",
            "Spring Boot",
            "Django",
            "Tailwind",
            "GitLab / GitHub",
            "Agile & Scrum",
        ],
    },
    {
        group: { en: "Design", de: "Design" },
        items: ["Figma", "Affinity Designer"],
    },
    {
        group: { en: "Operating Systems", de: "Betriebssysteme" },
        items: ["Linux / Unix", "macOS", "Windows"],
    },
    {
        group: { en: "Languages", de: "Sprachen" },
        items: [
            { en: "German (native)", de: "Deutsch (Muttersprache)" },
            { en: "English (C1)", de: "Englisch (C1)" },
        ],
    },
];

const coursework = [
    {
        title: { en: "Operating Systems", de: "Betriebssysteme" },
        body: {
            en: "Built a simplified OS in C++: user-space mutexes, thread management, shared memory, process handling.",
            de: "Ein vereinfachtes OS in C++ entwickelt: User-Space-Mutexe, Thread-Verwaltung, Shared Memory, Prozessverwaltung.",
        },
    },
    {
        title: {
            en: "Object Oriented Programming 2",
            de: "Objektorientierte Programmierung 2",
        },
        body: {
            en: "OpenStreetMap-based application in Java + Spring Boot.",
            de: "OpenStreetMap-basierte Anwendung in Java + Spring Boot.",
        },
    },
    {
        title: {
            en: "Agile Software Development & Project Management",
            de: "Agile Softwareentwicklung & Projektmanagement",
        },
        body: {
            en: "Team-based Scrum projects in Java and Angular: sprint planning, collaboration, and agile workflows.",
            de: "Team-Scrum-Projekte in Java und Angular: Sprint-Planung, Zusammenarbeit und agile Workflows.",
        },
    },
    {
        title: {
            en: "Senior Software Development",
            de: "Senior Softwareentwicklung",
        },
        body: {
            en: "Full-stack Django project: design patterns, testing strategy, and team leadership.",
            de: "Full-Stack-Django-Projekt: Design Patterns, Teststrategie und Teamleitung.",
        },
    },
];
---

<BaseLayout title="Resume" activeNav="cv" fullBleed={true}>
    <!-- HEADER -->
    <section class="bg-surface w-full">
        <div class="mx-auto max-w-[1100px] px-6 pt-20 pb-12">
            <div data-reveal class="mb-4 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Curriculum Vitae</span>
                <span data-lang="de">Curriculum Vitae</span>
            </div>
            <h1 data-reveal data-reveal-delay="1" class="text-5xl md:text-6xl font-bold tracking-tightish leading-[1.05] text-ink">
                Emily Gombocz
            </h1>
            <p data-reveal data-reveal-delay="2" class="mt-6 max-w-2xl text-lg text-ink-muted leading-relaxed">
                <span data-lang="en">Software Engineering & Management student at TU Graz, drawn to projects where careful engineering and considered design meet. I love turning rough ideas into things that work — and tend to bring the same care to the team behind them. Two years as a Teaching Assistant, multiple merit-based scholarships, and a semester in Memphis along the way.</span>
                <span data-lang="de">Studentin Software Engineering & Management an der TU Graz, fasziniert von Projekten, in denen sorgfältige Technik und durchdachtes Design zusammenkommen. Ich liebe es, aus neuen Ideen funktionierende Projekte entstehen zu lassen – und bringe die gleiche Sorgfalt für das Team mit, das dahintersteht. Zwei Jahre als studentische Tutorin, mehrere leistungsbasierte Stipendien und ein Auslandssemester in Memphis inklusive.</span>
            </p>
            <div
                data-reveal
                data-reveal-delay="3"
                class="mt-6 flex items-start gap-3 text-base text-ink-muted leading-relaxed max-w-2xl"
            >
                <span
                    class="mt-[0.55rem] inline-block h-2 w-2 shrink-0 rounded-full bg-accent"
                    aria-hidden="true"
                ></span>
                <p>
                    <span class="font-semibold text-ink">
                        <span data-lang="en">Currently:</span>
                        <span data-lang="de">Aktuell:</span>
                    </span>
                    <span data-lang="en">In the final year of my Bachelor of Science degree in Software Engineering and Management in Graz, Austria.</span>
                    <span data-lang="de">In den letzten Zügen meines Bachelor of Science in Software Engineering & Management in Graz, Österreich.</span>
                </p>
            </div>
            <div data-reveal data-reveal-delay="4" class="mt-8 flex gap-3 flex-wrap">
                <a
                    href="mailto:emily@gombocz.com"
                    class="inline-flex items-center rounded-full border border-accent px-6 py-3 text-sm font-medium text-accent hover:bg-accent/10 transition-colors"
                >
                    <span data-lang="en">Get in touch</span>
                    <span data-lang="de">Kontaktieren</span>
                </a>
            </div>
        </div>
    </section>

    <!-- EDUCATION -->
    <section class="bg-surface-alt w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-20">
            <div data-reveal class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Education</span>
                <span data-lang="de">Ausbildung</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-bold tracking-tightish text-ink mb-10">
                <span data-lang="en">Where I've studied.</span>
                <span data-lang="de">Akademischer Werdegang.</span>
            </h2>
            <div data-reveal data-reveal-delay="2" class="max-w-3xl">
                <TimeLineElement
                    title={{
                        en: "Bachelor's Degree, Software Engineering and Management",
                        de: "Bachelorstudium, Software Engineering and Management",
                    }}
                    subtitle={{
                        en: "2023 to present · Graz University of Technology, Graz, Austria",
                        de: "Seit 2023 · Technische Universität Graz, Graz, Österreich",
                    }}
                />
                <TimeLineElement
                    title={{
                        en: "Exchange Semester",
                        de: "Auslandssemester",
                    }}
                    subtitle={{
                        en: "2025 · Rhodes College, Memphis, TN, U.S.",
                        de: "2025 · Rhodes College, Memphis, TN, USA",
                    }}
                />
                <TimeLineElement
                    title={{
                        en: "Middle School & High School",
                        de: "Mittel- und Oberstufe",
                    }}
                    subtitle={{
                        en: "2015 to 2023 · MS BG BRG Klusemannstrasse, Graz, Austria",
                        de: "2015 bis 2023 · MS BG BRG Klusemannstraße, Graz, Österreich",
                    }}
                />
            </div>
        </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="bg-surface w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-20">
            <div data-reveal class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Experience</span>
                <span data-lang="de">Berufserfahrung</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-bold tracking-tightish text-ink mb-10">
                <span data-lang="en">Where I've worked.</span>
                <span data-lang="de">Arbeitserfahrung.</span>
            </h2>
            <div data-reveal data-reveal-delay="2" class="max-w-3xl">
                <TimeLineElement
                    title={{
                        en: "Upcoming Software Engineering Intern",
                        de: "Bevorstehendes Praktikum, Software Engineering",
                    }}
                    subtitle={{
                        en: "Jul 2026 - Aug 2026 · Beyond Now GmbH",
                        de: "Juli 2026 - Aug. 2026 · Beyond Now GmbH",
                    }}
                />
                <TimeLineElement
                    title={{
                        en: "Student Teaching Assistant",
                        de: "Studentische Tutorin",
                    }}
                    subtitle={{
                        en: "Mar 2026 - Jun 2026 · TU Graz",
                        de: "März 2026 - Juni 2026 · TU Graz",
                    }}
                >
                    <span data-lang="en">Mentored undergraduates in Project Management in Software Development and Agile Software Development: grading, tutorials, workshops, and one-on-one guidance.</span>
                    <span data-lang="de">Betreuung von Bachelor-Studierenden in den Lehrveranstaltungen Projektmanagement in der Softwareentwicklung und Agile Softwareentwicklung: Korrekturen, Tutorien, Workshops und individuelle Beratung.</span>
                </TimeLineElement>
                <TimeLineElement
                    title={{
                        en: "Student Teaching Assistant",
                        de: "Studentische Tutorin",
                    }}
                    subtitle={{
                        en: "Oct 2024 - Jun 2025 · TU Graz",
                        de: "Okt. 2024 - Juni 2025 · TU Graz",
                    }}
                >
                    <span data-lang="en">Mentored undergraduates in Introduction to Structured Programming and Project Management in Software Development: grading, tutorials, and one-on-one guidance.</span>
                    <span data-lang="de">Betreuung von Bachelor-Studierenden in Einführung in die strukturierte Programmierung und Projektmanagement in der Softwareentwicklung: Klausur-Korrekturen, Tutorien und Abhaltung von Fragestunden.</span>
                </TimeLineElement>
                <TimeLineElement
                    title={{
                        en: "Data Quality Management",
                        de: "Datenqualitäts-Management",
                    }}
                    subtitle={{
                        en: "Feb 2024 - Aug 2024 · Raiffeisenbank Kalsdorf-Lieboch-Stainz",
                        de: "Feb. 2024 - Aug. 2024 · Raiffeisenbank Kalsdorf-Lieboch-Stainz",
                    }}
                >
                    <span data-lang="en">Maintained customer data and supported data-quality work for a regional bank, including upkeep of Lotus Notes databases.</span>
                    <span data-lang="de">Wartung der Kundendaten und Unterstützung der Datenqualitätsarbeit einer Raiffeisenbank.</span>
                </TimeLineElement>
                <TimeLineElement
                    title={{
                        en: "Reception Employee",
                        de: "Rezeptionsmitarbeiterin",
                    }}
                    subtitle={{
                        en: "Aug 2023 - Dec 2023 · FlibLab Center West GmbH",
                        de: "Aug. 2023 - Dez. 2023 · FlibLab Center West GmbH",
                    }}
                >
                    <span data-lang="en">Ran front-desk operations at a children's entertainment facility: bookings, payments, and customer inquiries.</span>
                    <span data-lang="de">Empfangsbetreuung einer Kinder-Unterhaltungseinrichtung: Reservierungen, Zahlungen & Kundenanfragen und Sonderevents wie Geburtstage.</span>
                </TimeLineElement>
                <TimeLineElement
                    title={{
                        en: "Intern · Raiffeisenbank",
                        de: "Praktikantin · Raiffeisenbank",
                    }}
                    subtitle={{
                        en: "July 2023 · Raiffeisenbank Kalsdorf-Lieboch-Stainz",
                        de: "Juli 2023 · Raiffeisenbank Kalsdorf-Lieboch-Stainz",
                    }}
                >
                    <span data-lang="en">Supported marketing initiatives and back-office operations during a summer internship.</span>
                    <span data-lang="de">Unterstützung von Marketing-Initiativen und Back-Office-Tätigkeiten im Rahmen eines Sommerpraktikums.</span>
                </TimeLineElement>
            </div>
        </div>
    </section>

    <!-- COURSEWORK -->
    <section class="bg-surface-alt w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-20">
            <div data-reveal class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Coursework</span>
                <span data-lang="de">Studieninhalte</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-bold tracking-tightish text-ink mb-10">
                <span data-lang="en">Selected Coursework favourites.</span>
                <span data-lang="de">Ausgewählte Kursprojekte</span>
            </h2>
            <div data-reveal data-reveal-delay="2" class="grid gap-x-10 gap-y-6 md:grid-cols-2 max-w-4xl">
                {
                    coursework.map((c) => (
                        <div>
                            <h3 class="text-base font-semibold text-ink">
                                <span data-lang="en">{c.title.en}</span>
                                <span data-lang="de">{c.title.de}</span>
                            </h3>
                            <p class="mt-1 text-[15px] text-ink-muted leading-relaxed">
                                <span data-lang="en">{c.body.en}</span>
                                <span data-lang="de">{c.body.de}</span>
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ACHIEVEMENTS -->
    <section class="bg-surface w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-20">
            <div data-reveal class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Recognition</span>
                <span data-lang="de">Auszeichnungen</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-bold tracking-tightish text-ink mb-10">
                <span data-lang="en">Scholarships & honours.</span>
                <span data-lang="de">Stipendien & Auszeichnungen.</span>
            </h2>
            <ul data-reveal data-reveal-delay="2" class="grid gap-3 max-w-3xl text-[15px] text-ink-muted leading-relaxed">
                <li class="flex gap-3">
                    <span class="text-ink">·</span>
                    <span>
                        <span data-lang="en">Dean's List: top 5% of second-year Software Engineering &amp; Management · 2024/25</span>
                        <span data-lang="de">Dean's List: Top 5% des zweiten Studienjahres Software Engineering &amp; Management · 2024/25</span>
                    </span>
                </li>
                <li class="flex gap-3">
                    <span class="text-ink">·</span>
                    <span>
                        <span data-lang="en">Dean's List: top 10% of first-year Software Engineering &amp; Management · 2023/24</span>
                        <span data-lang="de">Dean's List: Top 10% des ersten Studienjahres Software Engineering &amp; Management · 2023/24</span>
                    </span>
                </li>
                <li class="flex gap-3">
                    <span class="text-ink">·</span>
                    <span>
                        <span data-lang="en">TU Graz 100 merit-based scholarship · 8000€ · 2023</span>
                        <span data-lang="de">TU Graz 100 Leistungsstipendium · 8000 € · 2023</span>
                    </span>
                </li>
                <li class="flex gap-3">
                    <span class="text-ink">·</span>
                    <span>
                        <span data-lang="en">CSBME faculty scholarship for academic excellence · 1200€ · 2024/25</span>
                        <span data-lang="de">CSBME-Fakultätsstipendium für akademische Exzellenz · 1200 € · 2024/25</span>
                    </span>
                </li>
                <li class="flex gap-3">
                    <span class="text-ink">·</span>
                    <span>
                        <span data-lang="en">CSBME faculty scholarship for academic excellence · 750€ · 2023/24</span>
                        <span data-lang="de">CSBME-Fakultätsstipendium für akademische Exzellenz · 750 € · 2023/24</span>
                    </span>
                </li>
                <li class="flex gap-3">
                    <span class="text-ink">·</span>
                    <span>
                        <span data-lang="en">AVL List scholarship for studying abroad · 3000€ · 2025</span>
                        <span data-lang="de">AVL-List-Stipendium für Auslandsstudien · 3000 € · 2025</span>
                    </span>
                </li>
            </ul>
        </div>
    </section>

    <!-- SKILLS -->
    <section class="bg-surface-alt w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-20">
            <div data-reveal class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Skills</span>
                <span data-lang="de">Skills</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-bold tracking-tightish text-ink mb-10">
                <span data-lang="en">Tools I use.</span>
                <span data-lang="de">Frameworks, Tools & Skills.</span>
            </h2>
            <div data-reveal data-reveal-delay="2" class="grid gap-10 max-w-4xl">
                {
                    skills.map((group) => (
                        <div>
                            <div class="text-sm font-medium uppercase tracking-[0.08em] text-ink-muted mb-3">
                                <span data-lang="en">{group.group.en}</span>
                                <span data-lang="de">{group.group.de}</span>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                {group.items.map((item) => (
                                    <span class="rounded-full border border-ink/10 bg-surface px-3.5 py-1.5 text-sm text-ink">
                                        {typeof item === "string" ? (
                                            item
                                        ) : (
                                            <>
                                                <span data-lang="en">{item.en}</span>
                                                <span data-lang="de">{item.de}</span>
                                            </>
                                        )}
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- SOFT SKILLS -->
    <section class="bg-surface w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-20">
            <div data-reveal class="mb-2 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Soft skills</span>
                <span data-lang="de">Soft Skills</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-bold tracking-tightish text-ink mb-10">
                <span data-lang="en">How I work.</span>
                <span data-lang="de">Wie ich arbeite.</span>
            </h2>
            <div data-reveal data-reveal-delay="2" class="grid gap-5 md:grid-cols-2 max-w-4xl">
                <div class="soft-skill-card rounded-2xl border border-ink/10 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_18px_40px_-18px_rgba(139,126,200,0.45)]">
                    <h3 class="text-base font-semibold text-ink">
                        <span data-lang="en">Disciplined work ethic</span>
                        <span data-lang="de">Disziplinierte Arbeitsweise</span>
                    </h3>
                    <p class="mt-2 text-[15px] text-ink-muted leading-relaxed">
                        <span data-lang="en">Two years as a Teaching Assistant taught me to plan carefully and follow through, even with parallel deadlines.</span>
                        <span data-lang="de">Zwei Jahre als studentische Tutorin haben mich gelehrt, vorausschauend zu planen und parallel laufende Deadlines zuverlässig einzuhalten.</span>
                    </p>
                </div>
                <div class="soft-skill-card rounded-2xl border border-ink/10 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_18px_40px_-18px_rgba(139,126,200,0.45)]">
                    <h3 class="text-base font-semibold text-ink">
                        <span data-lang="en">Fast learning</span>
                        <span data-lang="de">Schnelles Lernen</span>
                    </h3>
                    <p class="mt-2 text-[15px] text-ink-muted leading-relaxed">
                        <span data-lang="en">Started university-level coursework in secondary school; comfortable picking up new languages, tools, and conventions quickly.</span>
                        <span data-lang="de">Schon in der Schulzeit auf Universitätsniveau studiert; neue Sprachen, Werkzeuge und Konventionen eigne ich mir schnell an.</span>
                    </p>
                </div>
                <div class="soft-skill-card rounded-2xl border border-ink/10 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_18px_40px_-18px_rgba(139,126,200,0.45)]">
                    <h3 class="text-base font-semibold text-ink">
                        <span data-lang="en">Team-oriented thinking</span>
                        <span data-lang="de">Teamorientiertes Denken</span>
                    </h3>
                    <p class="mt-2 text-[15px] text-ink-muted leading-relaxed">
                        <span data-lang="en">At my best with a team. Scrum-based coursework and mentoring student teams have shaped how I collaborate.</span>
                        <span data-lang="de">Am stärksten im Team. Scrum-basierte Lehrveranstaltungen und die Betreuung studentischer Teams haben meinen Kollaborationsstil geprägt.</span>
                    </p>
                </div>
                <div class="soft-skill-card rounded-2xl border border-ink/10 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_18px_40px_-18px_rgba(139,126,200,0.45)]">
                    <h3 class="text-base font-semibold text-ink">
                        <span data-lang="en">Creative problem-solving</span>
                        <span data-lang="de">Kreatives Problemlösen</span>
                    </h3>
                    <p class="mt-2 text-[15px] text-ink-muted leading-relaxed">
                        <span data-lang="en">I look for the cleaner path, not the obvious one — whether that's an algorithm, a workflow, or a UI.</span>
                        <span data-lang="de">Ich suche den klareren Weg, nicht den naheliegenden – sei es bei einem Algorithmus, einem Workflow oder einer Benutzeroberfläche.</span>
                    </p>
                </div>
                <div class="soft-skill-card rounded-2xl border border-ink/10 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_18px_40px_-18px_rgba(139,126,200,0.45)]">
                    <h3 class="text-base font-semibold text-ink">
                        <span data-lang="en">Cross-cultural communication</span>
                        <span data-lang="de">Interkulturelle Kommunikation</span>
                    </h3>
                    <p class="mt-2 text-[15px] text-ink-muted leading-relaxed">
                        <span data-lang="en">An exchange semester at Rhodes College, Memphis, taught me to bridge different working styles and perspectives.</span>
                        <span data-lang="de">Ein Auslandssemester am Rhodes College in Memphis hat mir gezeigt, wie man unterschiedliche Arbeitsstile und Perspektiven verbindet.</span>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER LINK -->
    <section class="bg-surface-alt w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-16 text-center">
            <p data-reveal class="text-ink-muted text-[15px]">
                <span data-lang="en">
                    Want the rest? See
                    <a href="/" class="text-accent hover:underline">the work</a>
                    or
                    <a href="mailto:emily@gombocz.com" class="text-accent hover:underline">say hello</a>.
                </span>
                <span data-lang="de">
                    Schau dir gerne
                    <a href="/" class="text-accent hover:underline">die Projekte</a>
                    an oder
                    <a href="mailto:emily@gombocz.com" class="text-accent hover:underline">melde dich bei mir</a>.
                </span>
            </p>
        </div>
    </section>
</BaseLayout>
