---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectTile from "../components/ProjectTile.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import { personalRows } from "../data/projects";
---

<BaseLayout activeNav="home" fullBleed={true}>
    <!-- HERO -->
    <section class="relative min-h-[88vh] flex items-center">
        <div class="mx-auto max-w-[1100px] px-6 w-full">
            <div class="mb-6 text-sm font-medium uppercase tracking-[0.18em] text-ink-muted">
                Software Engineering & Management · TU Graz
            </div>
            <h1 class="text-[clamp(3rem,9vw,8rem)] font-bold tracking-tightish leading-[0.95] text-ink">
                Emily<br />Gombocz
            </h1>
            <p class="mt-10 max-w-2xl text-xl md:text-2xl text-ink-muted leading-snug">
                <span data-lang="en">TODO Connecting logic and creativity - from low-level systems to thoughtful interfaces.</span>
                <span data-lang="de">TODO Logik und Kreativität verbinden – von systemnaher Programmierung bis zu durchdachten Oberflächen.</span>
            </p>
            <div class="mt-12 flex gap-4">
                <a
                    href="#work"
                    class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-surface hover:opacity-85 transition-opacity"
                >
                    <span data-lang="en">See my work</span>
                    <span data-lang="de">Projekte ansehen</span>
                </a>
                <a
                    href="https://www.linkedin.com/in/emily-gombocz-1b28b5332/"
                    target="_blank"
                    rel="noopener"
                    class="rounded-full border border-ink/15 px-6 py-3 text-sm font-medium text-ink hover:border-ink/40 transition-colors"
                >
                    <span data-lang="en">Let's connect</span>
                    <span data-lang="de">Vernetzen wir uns</span>
                </a>
            </div>
        </div>

        <a
            href="#about"
            aria-label="Scroll down"
            class="absolute bottom-10 left-1/2 -translate-x-1/2 text-ink-muted hover:text-ink transition-colors"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12l7 7 7-7" />
            </svg>
        </a>
    </section>

    <!-- ABOUT -->
    <section id="about" class="bg-surface-alt w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-32">
            <div data-reveal class="mb-4 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">About</span>
                <span data-lang="de">Über mich</span>
            </div>
            <p data-reveal data-reveal-delay="1" class="text-3xl md:text-4xl font-medium tracking-tightish leading-[1.2] text-ink max-w-4xl">
                <span data-lang="en">I'm a Bachelor degree Software Engineering & Management student at Graz University of Technology, drawn to the spaces where careful engineering meets considered design.</span>
                <span data-lang="de">Ich studiere Software Engineering & Management im Bachelor an der TU Graz und interessiere mich besonders für die Schnittstelle zwischen solider Technik und durchdachtem Design.</span>
            </p>
            <p data-reveal data-reveal-delay="2" class="mt-8 text-lg text-ink-muted leading-relaxed max-w-3xl">
                <span data-lang="en">I started at university level while still in secondary school, and I've spent the years since chasing the kind of problems that reward both rigor and taste. The cherry on top to me was my semester abroad in Memphis, Tennessee in the U.S.</span>
                <span data-lang="de">Ich habe noch während der Schulzeit auf Universitätsniveau zu studieren begonnen und beschäftige mich seitdem mit Problemen, die sowohl Sorgfalt als auch Geschmack belohnen. Das Highlight war mein Auslandssemester in Memphis, Tennessee, in den USA.</span>
            </p>
        </div>
    </section>

    <!-- PROJECTS -->
    <section id="work" class="bg-surface-alt w-full overflow-hidden">
        <div class="mx-auto max-w-[1100px] px-6 pt-28 pb-10">
            <div data-reveal class="mb-3 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Selected work</span>
                <span data-lang="de">Ausgewählte Projekte</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-5xl md:text-7xl font-bold tracking-tightish leading-[1.02] text-ink">
                <span data-lang="en">Projects I've built.</span>
                <span data-lang="de">Projekte, die ich gebaut habe.</span>
            </h2>
        </div>

        <div
            data-reveal
            data-reveal-delay="2"
            class="mx-auto max-w-[1100px] px-6 pb-24"
        >
            {personalRows.map((row, idx) => (
                <div
                    class:list={[
                        "project-group relative",
                        idx > 0 && "mt-5 md:mt-6",
                    ]}
                    data-project-group
                >
                    <div class="tiles-grid grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-6">
                        {row.map((p) => (
                            <div
                                class:list={[
                                    p.size === "big" ? "md:col-span-8" : "md:col-span-4",
                                    idx === 1
                                        ? p.size === "big"
                                            ? "h-[180px] md:h-[300px]"
                                            : "h-[150px] md:h-[300px]"
                                        : p.size === "big"
                                            ? "h-[260px] md:h-[440px]"
                                            : "h-[220px] md:h-[440px]",
                                ]}
                            >
                                <ProjectTile tileId={p.id} {...p.tile} />
                            </div>
                        ))}
                    </div>
                    {row.map((p) => (
                        <ProjectPreview previewId={p.id} {...p.preview} />
                    ))}
                </div>
            ))}
        </div>
    </section>

    <!-- CV SNAPSHOT (placeholder) -->
    <section id="cv-snapshot" class="bg-surface w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-32">
            <div data-reveal class="mb-4 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">The short version</span>
                <span data-lang="de">Die Kurzversion</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-4xl md:text-5xl font-bold tracking-tightish leading-[1.05] text-ink max-w-3xl">
                <span data-lang="en">A few numbers that hint at the rest.</span>
                <span data-lang="de">Ein paar Zahlen, die den Rest andeuten.</span>
            </h2>
            <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-8">
                <div data-reveal>
                    <div class="text-5xl font-bold tracking-tightish text-ink">
                        3<span class="text-ink-muted" data-lang="en">rd</span><span class="text-ink-muted" data-lang="de">.</span>
                    </div>
                    <div class="mt-2 text-sm text-ink-muted">
                        <span data-lang="en">year SWE & Management</span>
                        <span data-lang="de">Studienjahr SWE & Management</span>
                    </div>
                </div>
                <div data-reveal data-reveal-delay="1">
                    <div class="text-5xl font-bold tracking-tightish text-ink">×2</div>
                    <div class="mt-2 text-sm text-ink-muted">
                        <span data-lang="en">Dean's List standings</span>
                        <span data-lang="de">Dean's-List-Auszeichnungen</span>
                    </div>
                </div>
                <div data-reveal data-reveal-delay="4">
                    <div class="text-5xl font-bold tracking-tightish text-ink">3</div>
                    <div class="mt-2 text-sm text-ink-muted">
                        <span data-lang="en">merit-based scholarships</span>
                        <span data-lang="de">leistungsbasierte Stipendien</span>
                    </div>
                </div>
                <div data-reveal data-reveal-delay="3">
                    <div class="text-5xl font-bold tracking-tightish text-ink">1</div>
                    <div class="mt-2 text-sm text-ink-muted">
                        <span data-lang="en">semester in Memphis, TN, U.S.</span>
                        <span data-lang="de">Auslandssemester in Memphis, TN, USA</span>
                    </div>
                </div>
            </div>
            <a
                data-reveal
                href="/cv"
                class="mt-16 inline-flex items-center gap-1 text-base font-medium text-accent hover:gap-2 transition-all"
            >
                <span data-lang="en">Read the full CV</span>
                <span data-lang="de">Vollständigen Lebenslauf lesen</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
            </a>
        </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="bg-surface-alt w-full">
        <div class="mx-auto max-w-[1100px] px-6 py-32 text-center">
            <div data-reveal class="mb-4 text-sm font-medium uppercase tracking-[0.12em] text-ink-muted">
                <span data-lang="en">Contact</span>
                <span data-lang="de">Kontakt</span>
            </div>
            <h2 data-reveal data-reveal-delay="1" class="text-5xl md:text-7xl font-bold tracking-tightish leading-[1.05] text-ink">
                <span data-lang="en">Let's build something.</span>
                <span data-lang="de">Lass uns etwas bauen.</span>
            </h2>
            <p data-reveal data-reveal-delay="2" class="mt-8 mx-auto max-w-xl text-lg text-ink-muted leading-relaxed">
                <span data-lang="en">For roles, projects - I'd love to hear from you!</span>
                <span data-lang="de">Für Stellen, Projekte – ich freue mich, von dir zu hören!</span>
            </p>
            <div data-reveal data-reveal-delay="3" class="mt-12 flex justify-center gap-4 flex-wrap">
                <a
                    href="mailto:emily@gombocz.com"
                    class="rounded-full bg-ink px-7 py-3.5 text-sm font-medium text-surface hover:opacity-85 transition-opacity"
                >
                    emily@gombocz.com
                </a>
                <a
                    href="https://www.linkedin.com/in/emily-gombocz-1b28b5332/"
                    target="_blank"
                    rel="noopener"
                    class="rounded-full border border-ink/15 px-7 py-3.5 text-sm font-medium text-ink hover:border-ink/40 transition-colors"
                >
                    LinkedIn
                </a>
                <a
                    href="https://github.com/emtchy"
                    target="_blank"
                    rel="noopener"
                    class="rounded-full border border-ink/15 px-7 py-3.5 text-sm font-medium text-ink hover:border-ink/40 transition-colors"
                >
                    GitHub
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
